# Template Environment Variables untuk Server / AI Agent di VPS
# Salin menjadi .env di VPS sesuai service backend / AI agent Anda

NODE_ENV=production
PORT=3000
AGENT_PORT=8000

# Daftar origin yang diizinkan mengakses API/Agent dari browser (pisahkan dengan koma)
# Ganti dengan domain Vercel produksi Anda + domain preview jika perlu
ALLOWED_ORIGINS=https://mitra.domain-anda.com,https://nebeng-mitra.vercel.app

# Secret untuk verifikasi webhook antara Backend <-> AI Agent (buat random string minimal 32 karakter)
AI_AGENT_WEBHOOK_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# URL Landing Page di Vercel (untuk link redirect / notifikasi WhatsApp / email oleh AI Agent)
FRONTEND_LANDING_URL=https://mitra.domain-anda.com
