# Template Environment Variables untuk Vercel (Production / Preview)
# Masukkan nilai-nilai ini di: Vercel Dashboard -> Project Settings -> Environment Variables

# URL Backend API di VPS (wajib HTTPS karena Vercel berjalan di HTTPS)
VITE_API_BASE_URL=https://api.domain-anda.com/api

# URL Endpoint AI Agent di VPS (untuk chat bantuan / onboarding / webhook)
VITE_AGENT_API_URL=https://api.domain-anda.com/agent

# Domain utama landing page di Vercel (opsional, untuk canonical URL & OG tags)
VITE_PUBLIC_SITE_URL=https://mitra.domain-anda.com
